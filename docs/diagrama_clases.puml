@startuml diagrama_clases
title Diagrama de Clases UML - Simulador de Sistema Bancario y Créditos (Proyecto Final POO)
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor #FFFFFF
skinparam PackageBorderColor #555555
skinparam PackageBackgroundColor #FAFAFA
skinparam RectangleBorderColor #555555
skinparam dpi 120
skinparam nodesep 40
skinparam ranksep 55
hide empty members

' ===================== LIBRERIA PROPIA =====================
package "LIBRERÍA PROPIA (.jar): motor.amortizacion" as LIB #E8F0FE {
  class CalculadoraAmortizacion {
    + calcularCuotaMensual(monto: double, tasaAnual: double, plazoMeses: int): double
    + generarTabla(monto: double, tasaAnual: double, plazoMeses: int): List<CuotaAmortizacion>
    + calcularTotalInteres(monto: double, tasaAnual: double, plazoMeses: int): double
    - validar(monto: double, tasaAnual: double, plazoMeses: int): void
  }
  class CuotaAmortizacion {
    - numero: int
    - cuota: double
    - interes: double
    - capital: double
    - saldoRestante: double
    + CuotaAmortizacion(numero: int, cuota: double, interes: double, capital: double, saldoRestante: double)
    + getNumero(): int
    + getCuota(): double
    + getInteres(): double
    + getCapital(): double
    + getSaldoRestante(): double
  }
  CalculadoraAmortizacion ..> CuotaAmortizacion : <<crea>>\n1..*
}

' ===================== APLICACION =====================
package "APLICACIÓN BANCARIA (BancoApp)" as APP #FFFBEA {

  package "vista (MVC - Vista, Swing)" as VISTA {
    class JFrame <<javax.swing>>
    class JPanel <<javax.swing>>
    class Main {
      + {static} main(args: String[]): void
    }
    class VentanaPrincipal {
      - layout: CardLayout
      - contenedor: JPanel
      - controladorPersistencia: ControladorPersistencia
      + VentanaPrincipal()
      + mostrarPantalla(nombre: String): void
      - configurarCierre(): void
    }
    class VistaLogin {
      - txtUsuario: JTextField
      - txtContrasena: JPasswordField
      - botonIngresar: JButton
      - controladorLogin: ControladorLogin
      + VistaLogin()
      + mostrarError(mensaje: String): void
    }
    class VistaDashboard {
      - labelNombre: JLabel
      - labelSaldo: JLabel
      - tablaTransacciones: JTable
      - botonCaja: JButton
      - botonPrestamo: JButton
      - botonGuardar: JButton
      - controladorCuenta: ControladorCuenta
      - controladorPersistencia: ControladorPersistencia
      + refrescar(): void
    }
    class VistaCaja {
      - txtMonto: JTextField
      - botonDepositar: JButton
      - botonRetirar: JButton
      - controladorCuenta: ControladorCuenta
      + limpiarCampos(): void
    }
    class VistaPrestamo {
      - txtMonto: JTextField
      - spinnerPlazo: JSpinner
      - tablaAmortizacion: JTable
      - botonSimular: JButton
      - botonAceptarPrestamo: JButton
      - controladorPrestamo: ControladorPrestamo
      + mostrarTabla(cuotas: List<CuotaAmortizacion>): void
    }
    class VistaGerente {
      - tablaClientes: JTable
      - tablaPrestamos: JTable
      - botonRegistrarPago: JButton
      - controladorGerente: ControladorGerente
      + refrescar(): void
    }
  }

  package "controlador (MVC - Controlador)" as CONTROL {
    class ControladorLogin {
      + iniciarSesion(usuario: String, contrasena: String): boolean
      + obtenerRolActual(): String
      + cerrarSesion(): void
    }
    class ControladorCuenta {
      + getNombreCliente(): String
      + getSaldo(): double
      + getUltimasTransacciones(): List<Transaccion>
      + depositar(monto: double): boolean
      + retirar(monto: double): boolean
    }
    class ControladorPrestamo {
      - tasaAnual: double
      - calculadora: CalculadoraAmortizacion
      - repositorio: RepositorioDatos
      + simularPrestamo(monto: double, plazo: int): List<CuotaAmortizacion>
      + getPrestamoActivo(): Prestamo
      + aceptarPrestamo(monto: double, plazo: int): boolean
    }
    class ControladorGerente {
      - calculadora: CalculadoraAmortizacion
      - repositorio: RepositorioDatos
      + getClientes(): List<Usuario>
      + getPrestamos(): List<Prestamo>
      + registrarPago(prestamo: Prestamo, monto: double): boolean
    }
    class ControladorPersistencia {
      - repositorio: RepositorioDatos
      + cargarAlIniciar(): void
      + guardar(): void
      + guardarAlCerrar(): void
    }
  }

  package "modelo (MVC - Modelo)" as MODELO {
    class Usuario {
      - nombre: String
      - telefono: String
      - contrasena: String
      - tarjeta: String
      - rol: String
      + consultarDatos(): String
      + getNombre(): String
      + getRol(): String
    }
    class Cuenta {
      - numeroCuenta: String
      - saldo: double
      + depositar(monto: double): double
      + retirar(monto: double): boolean
      + consultarSaldo(): double
    }
    class Prestamo {
      - monto: double
      - plazo: int
      - interes: double
      - pagoMensual: double
      - saldoPendiente: double
      + aprobarPrestamo(): void
      + realizarPago(monto: double): void
      + consultarDeuda(): double
    }
    class Transaccion {
      - idTransaccion: int
      - fecha: LocalDateTime
      - tipo: String
      - monto: double
      + registrar(): void
      + mostrarTransaccion(): String
      + obtenerTipo(): String
    }
  }

  package "datos (persistencia en .csv)" as DATOS {
    interface RepositorioDatos {
      + cargar(): void
      + guardar(): void
    }
    class RepositorioCSV {
      - carpetaDatos: String
      + RepositorioCSV()
      + cargar(): void
      + guardar(): void
      - leerArchivo(nombre: String): List<String>
      - escribirArchivo(nombre: String, lineas: List<String>): void
    }
    class ContextoBanco <<Singleton>> {
      - {static} instancia: ContextoBanco
      - usuarios: List<Usuario>
      - cuentas: List<Cuenta>
      - prestamos: List<Prestamo>
      - transacciones: List<Transaccion>
      - usuarioActual: Usuario
      - ContextoBanco()
      + {static} getInstancia(): ContextoBanco
      + buscarUsuario(nombre: String): Usuario
      + obtenerCuenta(usuario: Usuario): Cuenta
      + obtenerCliente(nombre: String): Usuario
      + obtenerPrestamoCliente(usuario: Usuario): Prestamo
      + agregarPrestamo(prestamo: Prestamo): void
      + agregarTransaccion(transaccion: Transaccion): void
      + obtenerUsuarioActual(): Usuario
      + establecerUsuarioActual(usuario: Usuario): void
      + obtenerUsuarios(): List<Usuario>
      + obtenerPrestamos(): List<Prestamo>
      + obtenerCuentas(): List<Cuenta>
      + limpiar(): void
    }
  }

  package "util" as UTIL {
    class Validacion {
      + {static} validarLogin(usuario: String, contrasena: String): boolean
      + {static} validarSaldo(saldo: double, monto: double): boolean
      + {static} validarMonto(monto: double): boolean
      + {static} validarPrestamo(monto: double, plazo: int): boolean
      + {static} soloLetras(texto: String): boolean
      + {static} soloNumeros(texto: String): boolean
      + {static} validarTelefono(telefono: String): boolean
      + {static} validarTarjeta(tarjeta: String): boolean
      + {static} validarContrasena(contrasena: String): boolean
      + {static} validarCamposVacios(campos: String[]): boolean
    }
  }
}

' ===================== RELACIONES =====================
' Main y ventana
Main ..> VentanaPrincipal : <<crea>>
VentanaPrincipal --|> JFrame
VistaLogin --|> JPanel
VistaDashboard --|> JPanel
VistaCaja --|> JPanel
VistaPrestamo --|> JPanel
VistaGerente --|> JPanel
VentanaPrincipal *-- "1" VistaLogin
VentanaPrincipal *-- "1" VistaDashboard
VentanaPrincipal *-- "1" VistaCaja
VentanaPrincipal *-- "1" VistaPrestamo
VentanaPrincipal *-- "1" VistaGerente

' Vista -> Controlador
VentanaPrincipal --> ControladorPersistencia
VistaLogin --> ControladorLogin
VistaDashboard --> ControladorCuenta
VistaDashboard --> ControladorPersistencia
VistaCaja --> ControladorCuenta
VistaPrestamo --> ControladorPrestamo
VistaGerente --> ControladorGerente
VistaPrestamo ..> CuotaAmortizacion : muestra

' Controlador -> Libreria
ControladorPrestamo --> "1" CalculadoraAmortizacion : calculadora
ControladorGerente --> "1" CalculadoraAmortizacion : calculadora

' Controlador -> Datos / Modelo
ControladorPersistencia --> RepositorioDatos : repositorio
ControladorPrestamo --> RepositorioDatos : repositorio
ControladorGerente --> RepositorioDatos : repositorio

CONTROL ..> ContextoBanco : leen y modifican
CONTROL ..> Validacion : validan

' Datos
RepositorioCSV ..|> RepositorioDatos
RepositorioCSV ..> ContextoBanco : llena / lee

' Modelo
ContextoBanco o-- "0..*" Usuario
ContextoBanco o-- "0..*" Cuenta
ContextoBanco o-- "0..*" Prestamo
ContextoBanco o-- "0..*" Transaccion
Usuario "1" -- "1" Cuenta : tiene >
Usuario "1" -- "0..*" Prestamo : solicita >
Cuenta "1" -- "0..*" Transaccion : registra >

' ===== acomodo (links ocultos) =====
VentanaPrincipal -[hidden]down-> ControladorLogin
VistaGerente -[hidden]down-> ControladorGerente
VistaPrestamo -[hidden]down-> ControladorPrestamo
ControladorPrestamo -[hidden]right-> CalculadoraAmortizacion
@enduml
