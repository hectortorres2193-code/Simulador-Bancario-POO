@startuml diagrama_secuencia
title Diagrama de Secuencia - Aceptar Préstamo
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam SequenceLifeLineBorderColor #555555
skinparam ParticipantBorderColor #333333
skinparam ParticipantBackgroundColor #FFFFFF
skinparam dpi 130
skinparam sequenceMessageAlign left
autonumber

actor Cliente
participant "vista:VistaPrestamo" as V
participant "controlador:ControladorPrestamo" as C
participant "<<util>>\nValidacion" as VAL
participant "<<librería>>\ncalculadora:CalculadoraAmortizacion" as LIB
participant "<<Singleton>>\nContextoBanco" as CTX
participant "cuenta:Cuenta" as CU
participant "repositorio:RepositorioCSV" as REPO
database "archivos .csv" as CSV

Cliente -> V : clic en "Aceptar Préstamo"
activate V
V -> V : actionPerformed()\nleer txtMonto y spinnerPlazo
V -> C : aceptarPrestamo(monto, plazo)
activate C

C -> VAL : validarPrestamo(monto, plazo)
activate VAL
VAL --> C : true / false
deactivate VAL

alt datos inválidos
  C --> V : false
  V --> Cliente : mensaje de error
else datos válidos
  C -> LIB : generarTabla(monto, tasaAnual, plazo)
  activate LIB
  LIB -> LIB : calcularCuotaMensual(monto, tasaAnual, plazo)
  LIB --> C : List<CuotaAmortizacion>
  deactivate LIB

  C -> LIB : calcularTotalInteres(monto, tasaAnual, plazo)
  activate LIB
  LIB --> C : totalInteres
  deactivate LIB

  C -> CTX : getInstancia()
  activate CTX
  CTX --> C : contexto
  C -> CTX : obtenerUsuarioActual()
  CTX --> C : usuario
  C -> C : new Prestamo(monto, plazo, interes, pagoMensual, saldoPendiente)
  note right of C
    interes = totalInteres
    pagoMensual = primera cuota de la tabla
    saldoPendiente = monto + totalInteres
  end note
  C -> CTX : agregarPrestamo(prestamo)
  C -> CTX : obtenerCuenta(usuario)
  CTX --> C : cuenta
  deactivate CTX

  C -> CU : depositar(monto)
  activate CU
  CU --> C : saldo actualizado
  deactivate CU

  C -> CTX : agregarTransaccion(new Transaccion(monto, fecha, "PRESTAMO"))

  C -> REPO : guardar()
  activate REPO
  REPO -> CTX : obtenerUsuarios() / obtenerCuentas() / obtenerPrestamos()
  CTX --> REPO : listas en memoria
  REPO -> CSV : escribirArchivo(usuarios, cuentas, prestamos, transacciones)
  CSV --> REPO : ok
  REPO --> C : listo
  deactivate REPO

  C --> V : true
  deactivate C
  V -> V : mostrarTabla(cuotas)
  V --> Cliente : confirmación + tabla de amortización\n(saldo actualizado en el dashboard)
end
deactivate V
@enduml
